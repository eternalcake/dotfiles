{
  "$schema": "https://opencode.ai/config.json",
  "model": "unsloth/Qwen3-Coder-Next-GGUF:BF16",
  "watcher": {
    "ignore": [
      ".git/**/**",
      ".venv/**/**",
      "venv/**/**",
      ".opencode/**/**",
      ".idea/**/**"
    ]
  },
  "agent": {
    "build": {
      "mode": "primary",
      "model": "unsloth/Qwen3-Coder-Next-GGUF:BF16",
      "prompt": "Output only the tool call immediately after thinking, without any introductory conversational sentences (e.g., 'I will now use the search tool')"
    }
  },
  "provider": {
    "HauhauCS": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp (local)",
      "options": {
        "baseURL": "http://127.0.0.1:8131"
      },
      "models": {
        "Qwen3.5-9B-Uncensored-HauhauCS-Aggressive:Q4_K_M": {
          "name": "Qwen3.5-9B:Q4_K_M",
          "tools": true,
        }
      }
    },
    "unsloth": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp (192.168.9.72)",
      "options": {
        "baseURL": "http://192.168.9.72:8080/v1"
      },
      "models": {
        "Qwen3.6-35B-A3B-GGUF:Q8_K_XL": {
          "name": "Qwen3.6-35B-A3B-GGUF:Q8_K_XL",
          "tools": true,
        },
        "Qwen3-Coder-Next-GGUF:BF16": {
          "name": "Qwen3-Coder-Next-GGUF:BF16",
          "tools": true,
        }
      }
    }
  },
  "lsp": {
    "pyright": {
      "command": ["pyright --watch"],
      "initialization": {
        "preferences": {
          "importModuleSpecifierPreference": "relative"
        }
      }
    },
    "bash": {
      "command": ["bash-language-server", "start"]
    },
    "lua-ls": {
      "command": ["lua-language-server"]
    },
    "yaml-ls": {
      "command": ["yaml-language-server", "--stdio"]
    }
  },
  "permission": {
    "bash": "allow",
    "edit": "allow",
    "read": "allow",
    "grep": "allow",
    "glob": "allow",
    "lsp": "allow",
    "skill": "allow",
    "todowrite": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "question": "allow",
  }
}
