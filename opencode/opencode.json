{
  "$schema": "https://opencode.ai/config.json",
  "model": "unsloth/gemma-4-12B-it-qat-GGUF:UD-Q4_K_XL",
  "watcher": {
    "ignore": [
    ]
  },
  "agent": {
    "build": {
      "mode": "primary",
      "model": "unsloth/gemma-4-12B-it-qat-GGUF:UD-Q4_K_XL",
      "prompt": "Output only the tool call immediately after thinking, without any introductory conversational sentences (e.g., 'I will now use the search tool')"
    }
  },
  "provider": {
    "unsloth": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp (local)",
      "options": {
        "baseURL": "http://localhost:8080/v1"
      },
      "models": {
        "gemma-4-12B-it-qat-GGUF:UD-Q4_K_XL": {
          "name": "Gemma 4",
          "tools": true,
        },
      }
    }
  },
  "lsp": {
    "bash": {
      "command": ["bash-language-server", "start"]
    },
    "yaml-ls": {
      "command": ["yaml-language-server", "--stdio"]
    }
  },
  "permission": {
    "bash": "allow",
    "edit": "allow",
    "read": "allow",
    "grep": "allow",
    "glob": "allow",
    "lsp": "allow",
    "skill": "allow",
    "todowrite": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "question": "allow",
  }
}
