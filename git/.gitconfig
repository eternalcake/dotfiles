[user]
	name = eternalcake
	email = eternalcake.sake@gmail.com
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[pull]
[core]
	excludesFile = ~/.gitignore
    pager = delta

[diff]
    colorMoved = default

[delta]
    dark = true
    line-numbers = true
    hyperlinks = true
    side-by-side = true
    true-color = always
    navigate = true
